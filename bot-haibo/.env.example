# Proxy (haibo); credentials only if your proxy needs auth
HAIBO_PROXY_HOST=209.101.201.73
HAIBO_PROXY_PORT=59100
HAIBO_PROXY_USERNAME=
HAIBO_PROXY_PASSWORD=

# Redis (BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# API server port (server listens on this port)
PORT=3001

# Browser: set to false to run headed
HEADLESS=true

# yandex_search_visit.js: 1 for servers without a display
HAIBO_HEADLESS=1
# Optional Python interpreter for the CAPTCHA solver (absolute path recommended)
# HAIBO_PYTHON=/path/to/bot_seo/bot-haibo/.venv/bin/python
